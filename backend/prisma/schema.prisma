generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String              @id @default(uuid())
  email                      String              @unique
  password                   String
  name                       String
  profileImageUrl            String?
  profileImagePublicId       String?
  // Set to "now" on every /auth/logout call for this user (see auth.service.js's
  // `logout`). authMiddleware rejects any access token whose `iat` claim predates
  // this timestamp - the fix for a stateless-JWT gap where a logged-out browser tab
  // could keep using its still-unexpired, already-issued access token for up to
  // JWT_ACCESS_EXPIRES_IN after logout. Null means "no restriction" (never logged out
  // since this column was added).
  tokensValidAfter           DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  refreshTokens              RefreshToken[]
  userRoles                  UserRole[]
  employees                  Employee[]
  auditLogs                  AuditLog[]
  uploadedDocuments          EmployeeDocument[]
  reviewAddenda              ReviewAddendum[]
  uploadedCandidateDocuments CandidateDocument[] @relation("CandidateDocumentUploader")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  resource        String
  action          String
  scope           String?
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Employee {
  id                           String              @id @default(uuid())
  userId                       String?
  user                         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Governed master data, not free text (docs/domain-department.md, ADR-D01/
  // D07) - mandatory, unlike branchId, since the schema's original
  // `department` String column (removed by migration
  // add_department_contract, after prisma/backfill-department.js ran) was
  // itself always required.
  departmentId                 String
  department                   Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  // Governed master data, not free text (docs/domain-designation.md,
  // ADR-DS01/DS07) - mandatory, same reasoning as departmentId above: the
  // schema's original `jobTitle` String column (removed by migration
  // add_designation_contract, after prisma/backfill-designation.js ran) was
  // itself always required.
  designationId                String
  designation                  Designation         @relation(fields: [designationId], references: [id], onDelete: Restrict)
  // Closed, code-defined enum, not a managed aggregate like Branch/
  // Department/Designation above (docs/domain-employment-type.md, ADR-ET01)
  // - unlike those three, no free-text precursor column ever existed here;
  // this is new ground, not a governance upgrade. Mandatory (ADR-ET02): no
  // "unknown" state. Deliberately no @default here - every future create
  // must specify it explicitly; existing rows were one-time backfilled to
  // FULL_TIME by migration add_employment_type (see that migration's SQL).
  employmentType               EmploymentType
  salary                       Decimal
  dateOfJoining                DateTime
  managerId                    String?
  manager                      Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                      Employee[]          @relation("EmployeeManager")
  branchId                     String?
  // Restrict, not SetNull (unlike userId/managerId above): domain-branch.md's
  // Decision 1 makes "never hard-deleted while referenced" a hard invariant,
  // not a preference - branch.service.js also enforces this at the app layer
  // before attempting a delete, so this is a defense-in-depth backstop, not
  // the only guard.
  branch                       Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Nullable (docs/domain-shift.md ADR-SH02) - mirrors branchId's optional
  // pattern, not departmentId/designationId's mandatory one: not every
  // employee necessarily operates under a fixed-hours expectation. Restrict,
  // not SetNull, for the same "never hard-deleted while referenced" reason
  // as branchId/departmentId/designationId above.
  shiftId                      String?
  shift                        Shift?              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  deletedAt                    DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  documents                    EmployeeDocument[]
  attendanceRecords            AttendanceRecord[]
  leaveRequests                LeaveRequest[]
  leaveBalances                LeaveBalance[]
  payslips                     Payslip[]
  performanceReviewsAsSubject  PerformanceReview[] @relation("PerformanceReviewSubject")
  performanceReviewsAsReviewer PerformanceReview[] @relation("PerformanceReviewReviewer")
  interviewsConducted          Interview[]
  hiredViaApplication          Application?

  // No @unique on userId: Prisma's schema DSL can't express a *partial*
  // unique constraint (scoped to non-deleted rows), so the real
  // uniqueness guarantee is a hand-written partial unique index in the
  // migration SQL instead - see migration
  // add_partial_unique_index_employee_userid. A plain @unique here would
  // permanently block re-using a userId after its Employee record is
  // soft-deleted, which contradicts the soft-delete design.
  @@index([userId])
  @@index([managerId])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([shiftId])
}

// See docs/domain-branch.md for the full business-architecture sign-off.
// Uses a status field, not deletedAt (ADR-B04) - Branch closure is a
// distinct kind of business event from Employee offboarding, deliberately
// not modeled with the same soft-delete idiom.
enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id                String           @id @default(uuid())
  name              String           @unique
  code              String?          @unique
  status            BranchStatus     @default(ACTIVE)
  // Optional (docs/domain-holiday-calendar.md, ADR-HC03) - fulfills the item
  // explicitly deferred in this domain's own Deferred Decisions table
  // ("timezone/statutory/holiday-calendar fields"), added additively without
  // altering any accepted Branch ADR. Absence means "no holidays applied,"
  // never an error - the positive-allowlist philosophy applied to Branch
  // itself this time, not just to what Branch is assigned to.
  holidayCalendarId String?
  holidayCalendar   HolidayCalendar? @relation(fields: [holidayCalendarId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employees         Employee[]
  jobRequisitions   JobRequisition[]

  @@index([holidayCalendarId])
}

// See docs/domain-department.md for the full business-architecture sign-off.
// Uses a status field, not deletedAt (ADR-D04), same reasoning as Branch.
enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String?          @unique
  status          DepartmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  employees       Employee[]
  jobRequisitions JobRequisition[]
}

// See docs/domain-designation.md for the full business-architecture sign-off.
// Uses a status field, not deletedAt (ADR-DS04), same reasoning as
// Branch/Department. Orthogonal to both (ADR-DS02) - no departmentId here.
enum DesignationStatus {
  ACTIVE
  INACTIVE
}

model Designation {
  id              String            @id @default(uuid())
  name            String            @unique
  code            String?           @unique
  status          DesignationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  employees       Employee[]
  jobRequisitions JobRequisition[]
}

// See docs/domain-employment-type.md for the full business-architecture
// sign-off. Unlike BranchStatus/DepartmentStatus/DesignationStatus above,
// this is not a lifecycle-status enum on a managed aggregate - it IS the
// aggregate (ADR-ET01): a closed, code-defined classification with no
// backing table, no repository, no CRUD service, because each value
// carries real downstream-behavior significance (future Leave accrual,
// Payroll calculation basis) that an admin-creatable row could never
// safely carry. Adding a value here is a deliberate code change + release,
// never a runtime admin action.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// See docs/domain-holiday-calendar.md for the full business-architecture
// sign-off. Uses a status field, not deletedAt (mirrors Branch/Department/
// Designation) - deactivation blocks future assignment to new Branches but
// never retroactively touches existing Branch.holidayCalendarId references
// or deletes Holiday entries.
enum HolidayCalendarStatus {
  ACTIVE
  INACTIVE
}

// Aggregate root (ADR-HC01) - a named, year-agnostic, reusable container of
// dated Holiday entries (ADR-HC02), referenced optionally by many Branches
// (ADR-HC03). No `code` field - unlike Branch/Department/Designation, this
// domain's own sign-off never names one as useful here.
model HolidayCalendar {
  id        String                @id @default(uuid())
  name      String                @unique
  status    HolidayCalendarStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  holidays  Holiday[]
  branches  Branch[]
}

// Child entity, cascade-deleted with its parent calendar (ADR-HC01 §3) - no
// independent identity meaningful outside HolidayCalendar, mirroring the
// existing Employee -> EmployeeDocument cascade shape. Unlike EmployeeDocument,
// entries here are freely editable/removable (docs/domain-holiday-calendar.md
// §2) - no other domain holds a direct reference to a specific Holiday row,
// consumers resolve "is date X a holiday" by date, never by Holiday id.
model Holiday {
  id                String          @id @default(uuid())
  holidayCalendarId String
  holidayCalendar   HolidayCalendar @relation(fields: [holidayCalendarId], references: [id], onDelete: Cascade)
  date              DateTime
  name              String
  isOptional        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Enforces §4's mandatory invariant ("a Holiday entry's date must be
  // unique within its own calendar") at the DB level, not just in the
  // service layer.
  @@unique([holidayCalendarId, date])
  @@index([holidayCalendarId])
}

// See docs/domain-shift.md for the full business-architecture sign-off.
// Uses a status field, not deletedAt (mirrors Branch/Department/Designation/
// HolidayCalendar) - deactivation blocks future assignment to new Employees
// but never retroactively touches existing Employee.shiftId references.
enum ShiftStatus {
  ACTIVE
  INACTIVE
}

// The seven weekdays a Shift's workingDays array is drawn from (ADR-SH01 §4:
// "a non-empty subset of the seven weekdays"). A dedicated enum, not a
// String[], so Postgres/Prisma reject an invalid day at the type level.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Independent, Employee-level aggregate (ADR-SH01) - no relationship to
// Branch/Department/Designation/HolidayCalendar, a deliberate continuation
// of the orthogonal-axis philosophy (docs/domain-shift.md §3). startTime/
// endTime are "HH:mm" strings, not DateTime - Postgres/Prisma have no
// first-class time-only type in this stack, and a DateTime would force an
// arbitrary date component onto what's semantically time-of-day only.
// Overnight shifts (ADR-SH03: endTime < startTime crosses midnight) are
// decided by comparing these strings, once, in the service layer - never
// reimplemented by a future consumer.
model Shift {
  id          String      @id @default(uuid())
  name        String      @unique
  startTime   String
  endTime     String
  workingDays Weekday[]
  status      ShiftStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  employees   Employee[]
}

// See docs/domain-attendance.md for the full business-architecture sign-off.
// A raw-fact historical ledger (ADR-AT01), not master data - breaks the
// create/update/archive/hard-delete-if-unreferenced mold every prior
// domain (Branch through Shift) followed. No status/archive field: a
// record is never "deactivated," only ever corrected. Cascade, not
// Restrict, on employeeId (unlike Branch/Department/Designation/Shift's
// FKs onto Employee) - this is owned-by-Employee history, mirroring
// EmployeeDocument's own Cascade, not referenced master data that must
// outlive its owner.
model AttendanceRecord {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Date-only in practice (time truncated to UTC midnight by the service
  // layer before every write/query) - enforces "one record per calendar
  // date" (ADR-AT02) regardless of what time of day a request arrives.
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  // A stored fact the admin/employee asserts, not a value derived from a
  // time threshold - domain-attendance.md names "Half-Day" as a resulting
  // status (§1) but never defines the business rule for it (minimum
  // hours? missing checkout?); inventing one would be an unverified
  // assumption, so this is a raw input instead, the same shape as
  // Holiday.isOptional.
  isHalfDay  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Enforces ADR-AT02's mandatory invariant at the DB level, not just in
  // the service layer.
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// See docs/domain-leave.md for the full business-architecture sign-off.
// Master data (ADR-LV01) - same status-lifecycle/hard-delete-if-
// unreferenced shape as Branch/Department/Designation. No `code` field:
// unlike those three, this domain's own sign-off never names one as
// useful here (same reasoning HolidayCalendar applied).
enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
}

model LeaveType {
  id                       String          @id @default(uuid())
  name                     String          @unique
  // Whole days, admin-configured per type (e.g. 18 for Annual, 10 for
  // Sick) - the base a LeaveBalance's entitlement is prorated from.
  defaultAnnualEntitlement Int
  // Named "not decided here" at Leave's own sign-off (docs/domain-leave.md
  // §2/§12) and left for Payroll to resolve, since only Payroll needs to
  // distinguish paid from unpaid leave (docs/domain-payroll.md's Payslip
  // deduction calculation, ADR-LV09). Defaults true: real-world leave
  // catalogs are dominated by paid types (Annual, Sick); unpaid leave is
  // the named exception (e.g. "Leave Without Pay"), and no existing
  // LeaveType rows exist yet to migrate.
  isPaid                   Boolean         @default(true)
  status                   LeaveTypeStatus @default(ACTIVE)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  requests                 LeaveRequest[]
  balances                 LeaveBalance[]
}

// Workflow aggregate (ADR-LV01) - this review's first explicit multi-party
// approval state machine. PENDING -> APPROVED | REJECTED (manager, or
// ADMIN when managerId is null); APPROVED -> CANCELLED only while
// future-dated (ADR-LV02, domain doc §2).
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String             @id @default(uuid())
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  // Date-only (truncated to UTC midnight by the service layer), same
  // convention as AttendanceRecord.date.
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  // Holiday/week-off-excluded day count (ADR-LV04), computed and stored
  // only at approval time - null while PENDING/REJECTED, since duration
  // is meaningless until the request is actually granted.
  durationDays Decimal?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // The "no two overlapping Pending/Approved requests" invariant (§4) is
  // a date-range overlap check, not expressible as a simple Prisma/SQL
  // unique constraint (would need a btree_gist exclusion constraint) - so
  // it is enforced in the service layer instead, consistent with this
  // project's preference for the simpler option absent a demonstrated need.
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
}

// Per-employee, per-leaveType, per-year ledger (ADR-LV01) - Leave's own
// internal aggregate, deliberately stored rather than computed-on-read
// (ADR-LV03, diverging from Attendance's ADR-AT03: this is intra-domain
// state updated at discrete events, not a cross-domain reconciliation).
// `remaining` is never stored - always `entitlement - consumed`,
// computed in the service/API response layer to avoid a redundant,
// driftable column.
model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  // Decimal, not Int - hire-year proration produces fractional days
  // (e.g. 9.07), same precision treatment as Employee.salary.
  entitlement Decimal
  consumed    Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

// See docs/domain-payroll.md for the full business-architecture sign-off.
// Confirmed with the user (2026-09-15) that Employee.salary represents a
// MONTHLY figure (ADR-PR05) - periodMonth/periodYear alone is therefore
// sufficient to express a period and to enforce non-overlap (ADR-PR01).
enum PayrollRunStatus {
  DRAFT
  PROCESSING
  FINALIZED
  PAID
}

model PayrollRun {
  id          String           @id @default(uuid())
  periodMonth Int
  periodYear  Int
  status      PayrollRunStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  payslips    Payslip[]

  // One run per calendar month (ADR-PR01's "periods must not overlap"),
  // trivially guaranteed at monthly granularity.
  @@unique([periodMonth, periodYear])
}

// Every input this aggregate depends on is snapshotted at generation
// time, never live-joined afterward (ADR-PR02) - this is the direct,
// concrete cost of Branch/Department/Designation's earlier "single
// current value, no history" decisions (ADR-B03/ADR-D03/ADR-DS03)
// surfacing here, exactly as those domains' own docs anticipated.
// `employeeId` uses Restrict, not the Cascade every other Employee-owned
// domain in this review uses (Attendance/Leave) - a Payslip is a
// permanent financial record, not an operational one, so it must survive
// even in the (essentially theoretical, given ADR-006's soft-delete
// convention) case of a hard-deleted Employee row.
model Payslip {
  id                  String            @id @default(uuid())
  payrollRunId        String
  payrollRun          PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Denormalized from the parent run so a Payslip is a complete,
  // self-contained record - an employee reading their own Payslip via
  // `payslip:read:own` never needs `payrollRun:read` to know what period
  // it covers.
  periodMonth         Int
  periodYear          Int
  // Org-context snapshot (ADR-PR02) - nullable because Employee.userId
  // (the only source of a display name in this schema) is itself
  // optional; branchName is nullable because branchId is optional
  // (ADR-B03's own nullable pattern), department/designation names are
  // never null since both are mandatory on Employee (ADR-D07/DS07).
  employeeName        String?
  departmentName      String
  designationName     String
  branchName          String?
  employmentType      EmploymentType
  baseSalary          Decimal
  workingDaysInPeriod Decimal
  paidDays            Decimal
  unpaidDays          Decimal
  grossPay            Decimal
  totalDeductions     Decimal
  netPay              Decimal
  generatedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lineItems           PayslipLineItem[]

  @@unique([employeeId, payrollRunId])
  @@index([payrollRunId])
  @@index([employeeId])
}

enum PayslipLineItemType {
  EARNING
  DEDUCTION
}

// Generalized shape (ADR-PR03), not fixed columns (incomeTax, pf, ...) -
// the same "avoid a wide, brittle schema" reasoning already applied to
// AuditLog's entityType/entityId and EmployeeDocument's generic model.
// The deliberate seam for tax/statutory calculation logic to attach to
// later (ADR-PR04) without a schema redesign.
model PayslipLineItem {
  id        String              @id @default(uuid())
  payslipId String
  payslip   Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      PayslipLineItemType
  label     String
  amount    Decimal
  createdAt DateTime            @default(now())

  @@index([payslipId])
}

// See docs/domain-performance.md for the full business-architecture
// sign-off. Master data, same status-lifecycle shape as Branch/Department/
// Designation/Shift/HolidayCalendar/LeaveType - OPEN/CLOSED instead of
// ACTIVE/INACTIVE, the domain doc's own suggested naming (§2), but
// structurally identical.
enum ReviewCycleStatus {
  OPEN
  CLOSED
}

model ReviewCycle {
  id        String              @id @default(uuid())
  name      String              @unique
  startDate DateTime
  endDate   DateTime
  status    ReviewCycleStatus   @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  reviews   PerformanceReview[]
}

// This review's second explicit multi-party workflow after Leave
// (ADR-PF01). Draft -> Submitted -> Acknowledged (ADR-PF01, §2) -
// PATCH only permitted while Draft; once Submitted, further correction
// goes through ReviewAddendum, giving "Submitted" real meaning as a
// checkpoint rather than an edit-anytime label (a deliberately stricter
// reading than the domain doc's own looser wording, flagged in this
// domain's implementation notes).
enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

// A closed 5-value categorical scale (implementation choice - the domain
// doc allows either "a single categorical or numeric rating" without
// mandating one, §4). A closed enum needs no separate range-validation
// logic, mirroring EmploymentType's ADR-ET01 precedent.
enum PerformanceRating {
  OUTSTANDING
  EXCEEDS_EXPECTATIONS
  MEETS_EXPECTATIONS
  BELOW_EXPECTATIONS
  UNSATISFACTORY
}

// Both employeeId and reviewerId use Restrict, not Attendance/Leave's
// Cascade - the domain doc itself analogizes acknowledgement to Payroll's
// finalization rule ("a lighter-weight echo," §2), so this is treated as
// a personnel record with retention value, like a Payslip, not a pure
// operational fact like an attendance check-in.
model PerformanceReview {
  id              String                  @id @default(uuid())
  employeeId      String
  employee        Employee                @relation("PerformanceReviewSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  // Resolved from Employee.managerId at creation time (ADR-PF02, reuses
  // the same relationship Leave's approval workflow reuses) - not a live
  // join, so a later manager change never retroactively rewrites who
  // authored a past review.
  reviewerId      String
  reviewer        Employee                @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewCycleId   String
  reviewCycle     ReviewCycle             @relation(fields: [reviewCycleId], references: [id], onDelete: Restrict)
  status          PerformanceReviewStatus @default(DRAFT)
  rating          PerformanceRating?
  managerComments String?
  selfComments    String?
  // Recommended-not-mandatory org-context snapshot (ADR-PF03), taken at
  // submission time specifically (the domain doc's own explicit wording,
  // §3's Recommended Practices) - not at creation, since the review's
  // organizational context is only meaningful once the assessment is
  // actually being finalized. Null while Draft.
  departmentName  String?
  designationName String?
  branchName      String?
  submittedAt     DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  addenda         ReviewAddendum[]

  @@unique([employeeId, reviewCycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewCycleId])
}

// Append-only (ADR-PF03's "addenda, not edits" recommended practice, §2) -
// the mechanism for adding commentary once a review is Acknowledged
// without editing its frozen content. authorId uses the same User-plus-
// SetNull actor-reference convention as AuditLog.actorId/
// EmployeeDocument.uploadedBy.
model ReviewAddendum {
  id                  String            @id @default(uuid())
  performanceReviewId String
  performanceReview   PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  authorId            String?
  author              User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comment             String
  createdAt           DateTime          @default(now())

  @@index([performanceReviewId])
}

// See docs/domain-recruitment.md for the full business-architecture
// sign-off. JobRequisition mirrors the same four axes an Employee
// ultimately carries (ADR-RC01, §3) - departmentId/designationId
// mandatory, branchId optional, exactly matching Employee's own
// nullability for each, and reuses the existing EmploymentType enum
// rather than inventing a Recruitment-specific one.
enum JobRequisitionStatus {
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

model JobRequisition {
  id                String               @id @default(uuid())
  departmentId      String
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId     String
  designation       Designation          @relation(fields: [designationId], references: [id], onDelete: Restrict)
  branchId          String?
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employmentType    EmploymentType
  numberOfOpenings  Int
  // Decrements on each successful Hire (§4's mandatory invariant); the
  // requisition auto-transitions to CLOSED when this reaches zero. Starts
  // equal to numberOfOpenings at creation.
  remainingOpenings Int
  status            JobRequisitionStatus @default(OPEN)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  applications      Application[]

  @@index([departmentId])
  @@index([designationId])
  @@index([branchId])
}

// Not a User (ADR-RC02) - no system login prior to hire, no verified
// requirement for a candidate self-service portal. No uniqueness
// constraint on email, unlike User.email - a recruiter, not a schema
// constraint, is responsible for not creating an accidental duplicate
// (no verified requirement for fuzzy-dedup logic).
model Candidate {
  id           String              @id @default(uuid())
  name         String
  email        String
  phone        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  documents    CandidateDocument[]
  applications Application[]
}

// Mirrors EmployeeDocument's exact shape (§3: "reuses the same generic
// pattern already established by EmployeeDocument") rather than forcing
// polymorphism onto that already-accepted model - a separate table with
// an identical field shape, FK'd to Candidate instead of Employee.
model CandidateDocument {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  url          String
  publicId     String
  resourceType String
  fileName     String
  mimeType     String
  size         Int
  uploadedBy   String?
  uploader     User?     @relation("CandidateDocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([candidateId])
}

// The join between Candidate and JobRequisition (§3), carrying its own
// workflow status independent of both. APPLIED->SCREENING->INTERVIEW->OFFER
// is strictly sequential (no skipping, consistent with every other guarded
// workflow in this project); REJECTED/WITHDRAWN are reachable from any
// non-terminal stage. HIRED is deliberately not settable through the
// generic status transition - it is only ever reached via the dedicated
// Hire action (application.service.js), so the onboarding side-effect
// always fires (implementation decision, not stated verbatim in the
// domain doc).
enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model Application {
  id               String            @id @default(uuid())
  candidateId      String
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  jobRequisitionId String
  jobRequisition   JobRequisition    @relation(fields: [jobRequisitionId], references: [id], onDelete: Restrict)
  status           ApplicationStatus @default(APPLIED)
  hiredEmployeeId  String?           @unique
  hiredEmployee    Employee?         @relation(fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  interviews       Interview[]
  offers           Offer[]

  @@index([candidateId])
  @@index([jobRequisitionId])
}

// Kept minimal (§4's Recommended Practices) - scheduled time, interviewer,
// feedback text, recommendation. No interview-panel management, structured
// scorecards, or multi-round calibration workflow. A child of Application,
// not Candidate directly - an Application can carry multiple Interview rows
// (one per round), same one-to-many shape as ReviewAddendum under
// PerformanceReview.
enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

model Interview {
  id             String                   @id @default(uuid())
  applicationId  String
  application    Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull - a personnel record with retention value, same
  // reasoning as PerformanceReview.reviewerId (docs/domain-performance.md).
  interviewerId  String
  interviewer    Employee                 @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  scheduledAt    DateTime
  feedback       String?
  recommendation InterviewRecommendation?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([applicationId])
  @@index([interviewerId])
}

// Compensation and start-date terms proposed to a Candidate for a specific
// Application, not the Candidate directly (§3 - a candidate could have
// multiple applications over time). Only one PENDING Offer may exist per
// Application at a time (§4's mandatory invariant) - enforced by a partial
// unique index (see this migration's raw SQL), the same mechanism as
// PayrollRun's duplicate-period guard. Salary is free-entry, no Grade/Band
// validation (§5 - no Grade/Band domain exists project-wide).
enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Offer {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  salary        Decimal
  startDate     DateTime
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  url          String
  publicId     String
  // Cloudinary's OWN classification of the upload (from its response, not
  // guessed from mimeType) - required to delete the correct asset later.
  // cloudinary.uploader.destroy() defaults to resource_type "image" and
  // silently no-ops (returns {result: "not found"}, not an error) for any
  // other type - discovered live while verifying this feature's delete
  // flow, not by code review.
  resourceType String
  fileName     String
  mimeType     String
  size         Int
  uploadedBy   String?
  uploader     User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
