# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# --- Database (PostgreSQL via Prisma) ---
# Use a dedicated, least-privilege application role/database - never the
# Postgres superuser. See planning/feature-03-postgres-prisma-setup.md.
DATABASE_URL=postgresql://employee_management_app:replace_with_a_strong_password@localhost:5432/employee_management_db

# --- JWT Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- API Docs (Swagger / OpenAPI) ---
# Off by default in every environment, including development - must be
# explicitly turned on. Serves an interactive UI at /api-docs and the raw
# spec at /api-docs.json, both of which expose the full endpoint/field
# surface of the API. Recommended for local dev; leave off in production
# unless there's a real need (e.g. a partner integration).
ENABLE_SWAGGER=true
