# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# --- Database (PostgreSQL via Prisma) ---
# Use a dedicated, least-privilege application role/database - never the
# Postgres superuser. See planning/feature-03-postgres-prisma-setup.md.
DATABASE_URL=postgresql://employee_management_app:replace_with_a_strong_password@localhost:5432/employee_management_db

# --- JWT Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
